# Copy to .env locally. Creator profiles reference these variable NAMES.
# Copy config/credential-bindings.example.json to .nemoqwen/credential-bindings.json
# and bind each creator/platform/key to the permitted variable name.
# NEMOQWEN_ALLOW_LEGACY_CREDENTIAL_REFS=1 is an explicit compatibility override only.
CREATOR_X_ACCESS_TOKEN=
CREATOR_REDDIT_ACCESS_TOKEN=
CREATOR_FACEBOOK_PAGE_ACCESS_TOKEN=
CREATOR_TIKTOK_ACCESS_TOKEN=
CREATOR_YOUTUBE_ACCESS_TOKEN=

# Optional additional trusted local-media roots. Use the OS path delimiter
# (":" on Unix/Termux, ";" on Windows). A loaded manifest's own directory is trusted automatically.
NEMOQWEN_ASSET_ROOTS=
